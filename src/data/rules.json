    {
      "id": "GG",
      "name": "General Game Rules",
      "color": "#2563eb",
      "rules": [
        {
          "code": "GG1",
          "title": "Only Drive Team Members, and only in the Alliance Station",
          "description": "Only up to 3 drive team members, No communication devices",
          "severity": "variable"
        },
        {
          "code": "GG2",
          "title": "A Teams Robot should attend every Match",
          "description": "No robot will mean a NO SHOW",
          "severity": "variable"
        },
        {
          "code": "GG3",
          "title": "Robots on the Field must be ready to play",
          "description": "battery charged, sized within the starting size constraint, includes only the correct Alliance-color license plates, etc",
          "severity": "variable"
        },
        {
          "code": "GG4",
          "title": " Hands out of the Field",
          "description": "(SG11 for match loading disrupts this rule)",
          "severity": "variable"
